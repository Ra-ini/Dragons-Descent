      </li>
      <li>
        <label>Blue dragon</label>
        <labelPlural>Blue dragons</labelPlural>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/BLDragon/BLDragon1</texPath>
          <drawSize>4.2</drawSize>
          <shadowData>
            <volume>(1, 0.8, 0.5)</volume>
            <offset>(0,0,-0.5)</offset>
          </shadowData>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/CDragon_skeleton</texPath>
          <drawSize>3.3</drawSize>
        </dessicatedBodyGraphicData>
        <butcherBodyPart>
          <bodyPartGroup>HornAttackTool</bodyPartGroup>
          <thing>DragonHorn</thing>
        </butcherBodyPart>
      </li>
      <li>
        <label>Elder blue dragon</label>
        <labelPlural>Elder blue dragons</labelPlural>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/BLDragon/BLDragon1</texPath>
          <drawSize>4.4</drawSize>
          <shadowData>
            <volume>(1, 0.8, 0.5)</volume>
            <offset>(0,0,-0.5)</offset>
          </shadowData>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/CDragon_skeleton</texPath>
          <drawSize>3.3</drawSize>
        </dessicatedBodyGraphicData>
        <butcherBodyPart>
          <bodyPartGroup>HornAttackTool</bodyPartGroup>
          <thing>DragonHorn</thing>
        </butcherBodyPart>
      </li>
      <li>
        <label>Ancient blue dragon</label>
        <labelPlural>Ancient blue dragons</labelPlural>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/BLDragon/BLDragon1</texPath>
          <drawSize>4.6</drawSize>
          <shadowData>
            <volume>(1, 0.8, 0.5)</volume>
            <offset>(0,0,-0.5)</offset>
          </shadowData>
        </bodyGraphicData>
        <dessicatedBodyGraphicData>
          <texPath>Things/Pawn/Animal/CDragon_skeleton</texPath>
          <drawSize>4.2</drawSize>
        </dessicatedBodyGraphicData>
        <butcherBodyPart>
          <bodyPartGroup>HornAttackTool</bodyPartGroup>
          <thing>DragonHorn</thing>
        </butcherBodyPart>
      </li>

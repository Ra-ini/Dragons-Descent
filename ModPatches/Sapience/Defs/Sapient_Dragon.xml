        </dessicatedBodyGraphicData>
      </li>
      <li>
        <label>Blue dragon wyrmling</label>
        <labelPlural>Blue dragon wyrmlings</labelPlural>
        <bodyGraphicData>
          <texPath>Things/Pawn/Animal/BLDragon/BLDragon1</texPath>
          <drawSize>3.3</drawSize>
          <shadowData>
            <volume>(0.7, 0.6, 0.4)</volume>

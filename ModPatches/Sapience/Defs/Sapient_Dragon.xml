<Defs>
  <HediffDef ParentName="BS_DefaultRaceTracker">
    <defName>DD_Blue_Dragon_RaceHediff</defName> 
    <description>RAWR!</description>
    <label>derg</label>
    <defaultLabelColor>(0.5, 1, 1)</defaultLabelColor>
    <modExtensions>
      <li Class="BigAndSmall.PawnExtension">
        <traitIcon>Things/Pawn/Animal/BLDragon/BLDragon3_east</traitIcon>
        <animalFineManipulation>1.0</animalFineManipulation>
        <hideHumanlikeRenderNodes>true</hideHumanlikeRenderNodes>
        <romanceTags>
          <Dragon>1.0</Dragon>
          <White_Dragon>0.8</White_Dragon>
          <HumanLike>0.1</HumanLike>
        </romanceTags>
        <nullsThoughts>
          <li MayRequire="Ludeon.Romworld.Ideology">GroinUncovered_Disapproved_Male</li>
          <li MayRequire="Ludeon.Romworld.Ideology">GroinUncovered_Disapproved_Female</li>
          <li MayRequire="Ludeon.Romworld.Ideology">GroinUncovered_Disapproved_Social_Male</li>
          <li MayRequire="Ludeon.Romworld.Ideology">GroinUncovered_Disapproved_Social_Female</li>
          <li MayRequire="Ludeon.Romworld.Ideology">GroinOrChestUncovered_Disapproved_Male</li>
          <li MayRequire="Ludeon.Romworld.Ideology">GroinOrChestUncovered_Disapproved_Female</li>
          <li MayRequire="Ludeon.Romworld.Ideology">GroinOrChestUncovered_Disapproved_Social_Male</li>
          <li MayRequire="Ludeon.Romworld.Ideology">GroinOrChestUncovered_Disapproved_Social_Female</li>
          <li MayRequire="Ludeon.Romworld.Ideology">GroinChestOrHairUncovered_Disapproved_Male</li>
          <li MayRequire="Ludeon.Romworld.Ideology">GroinChestOrHairUncovered_Disapproved_Female</li>
          <li MayRequire="Ludeon.Romworld.Ideology">GroinChestOrHairUncovered_Disapproved_Social_Male</li>
          <li MayRequire="Ludeon.Romworld.Ideology">GroinChestOrHairUncovered_Disapproved_Social_Female</li>
          <li>Naked</li>
          <li>AteWithoutTable</li>
        </nullsThoughts>
        <apparelRestrictions>
          <noArmor>true</noArmor>
          <thingDefs>
            <allowlist><li>Apparel_ShieldBelt</li></allowlist>
          </thingDefs>
          <apparelLayers>
            <blacklist>
              <li>Shell</li>
              <li>Overhead</li>
            </blacklist>
          </apparelLayers>
          <bodyPartGroups>
            <blacklist>
              <li>FullHead</li>
            </blacklist>
          </bodyPartGroups>
        </apparelRestrictions>
        <disableFacialAnimations>true</disableFacialAnimations>
      </li>
    </modExtensions>
    <comps> <li Class="BigAndSmall.CompProperties_Race"> <canSwapAwayFrom>false</canSwapAwayFrom> </li> </comps>
  </HediffDef>

  <ThingDef ParentName="AnimalThingBase">
    <defName>DD_Blue_Dragon</defName>
    <label>sapient blue dragon</label>
    <description>rawr!</description>
    <statBases>
      <MoveSpeed>5.2</MoveSpeed>
      <ImmunityGainSpeed>2</ImmunityGainSpeed>
      <ComfyTemperatureMin>-75</ComfyTemperatureMin>
      <ComfyTemperatureMax>120</ComfyTemperatureMax>
      <ArmorRating_Blunt>0.95</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.8</ArmorRating_Sharp>
      <ArmorRating_Heat>1.6</ArmorRating_Heat>
      <PainShockThreshold>.85</PainShockThreshold>
      <MeatAmount>200</MeatAmount>
      <LeatherAmount>60</LeatherAmount>
      <MarketValue>6600</MarketValue>
      <PsychicSensitivity>.5</PsychicSensitivity>
      <ToxicResistance>0.35</ToxicResistance>
      <Flammability>0</Flammability>
      <MeleeDodgeChance>15</MeleeDodgeChance>
      <ToxicEnvironmentResistance MayRequire="Ludeon.RimWorld.Biotech">1</ToxicEnvironmentResistance>
      <IncomingDamageFactor>0.9</IncomingDamageFactor>
      <!-- <CaravanRidingSpeedFactor>1.6</CaravanRidingSpeedFactor> -->
      <Wildness>0.95</Wildness>
    </statBases>
    <uiIconScale>1.75</uiIconScale>
    <tools>
      <li>
        <label>left claw</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>18</power>
        <armorPenetration>0.2</armorPenetration>
        <cooldownTime>1.5</cooldownTime>
        <linkedBodyPartsGroup>FrontLeftPaw</linkedBodyPartsGroup>

      </li>
      <li>
        <label>right claw</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>18</power>
        <armorPenetration>0.2</armorPenetration>
        <cooldownTime>1.5</cooldownTime>
        <linkedBodyPartsGroup>FrontRightPaw</linkedBodyPartsGroup>
      </li>

      <li>
        <label>frost bite</label>
        <capacities>
          <li>Frost_Bite</li>
        </capacities>
        <power>20</power>
        <armorPenetration>1.0</armorPenetration>
        <cooldownTime>6</cooldownTime>
        <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
      </li>
      <li>
        <label>tail whip</label>
        <capacities>
          <li>Scratch</li>
          <li>Cut</li>
        </capacities>
        <power>5</power>
        <armorPenetration>.4</armorPenetration>
        <cooldownTime>5.0</cooldownTime>
        <linkedBodyPartsGroup>Tail</linkedBodyPartsGroup>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>20</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
      <li>
        <label>horn</label>
        <capacities>
          <li>Scratch</li>
          <li>Stab</li>
        </capacities>
        <power>10</power>
        <armorPenetration>.8</armorPenetration>
        <cooldownTime>5.0</cooldownTime>
        <linkedBodyPartsGroup>Horns</linkedBodyPartsGroup>
        <surpriseAttack>
          <extraMeleeDamages>
            <li>
              <def>Stun</def>
              <amount>20</amount>
            </li>
          </extraMeleeDamages>
        </surpriseAttack>
      </li>
      <li>
        <label>DD_Knockback</label>
        <capacities>
          <li>DD_Knockback</li>
        </capacities>
        <power>15</power>
        <armorPenetration>0.9</armorPenetration>
        <cooldownTime>1.0</cooldownTime>
        <linkedBodyPartsGroup>Tail</linkedBodyPartsGroup>
        <chanceFactor>.2</chanceFactor>
      </li>
    </tools>
    <comps>
      <li Class="VEF.AnimalBehaviours.CompProperties_DiseaseImmunity">
        <hediffsToRemove>
          <li>SandInEyes</li>
          <li>DirtInEyes</li>
          <li>MudInEyes</li>
          <li>GravelInEyes</li>
        </hediffsToRemove>
        <tickInterval>250</tickInterval>
      </li>
      <li Class="DD.CompProperties_Scaleable">
        <scaleDef>HardScale</scaleDef>
        <minScaleableLifeStage>HumanlikeAdult</minScaleableLifeStage>
        <scaleIntervalDays>15</scaleIntervalDays>
        <scaleAmount>60</scaleAmount>
      </li>
      <li Class="VEF.Apparels.CompProperties_ShieldBubble">
        <compClass>VEF.Abilities.CompAbilities</compClass>
        <blockRangedAttack>False</blockRangedAttack>
        <blockMeleeAttack>False</blockMeleeAttack>
        <showAlways>True</showAlways>
      </li>
      <li Class="DD.CompProperties_CrossbredEggLayer">
        <eggUnfertilizedDef>EggDragonUnfertilized</eggUnfertilizedDef>
        <eggFertilizedDef>EggBlueDragonFertilized</eggFertilizedDef>
        <eggFertilizationCountMax>1</eggFertilizationCountMax>
        <eggLayIntervalDays>40</eggLayIntervalDays>
        <eggProgressUnfertilizedMax>0.5</eggProgressUnfertilizedMax>
        <eggCountRange>1</eggCountRange>
        <failChance>0.25</failChance>
        <paternalChance>0.5</paternalChance>
        <maternalChance>0.5</maternalChance>
      </li>
    </comps>
    <race>
      <!-- Custom -->
      <renderTree>BS_HumanlikeAnimal</renderTree>
      <hasUnnaturalCorpse>false</hasUnnaturalCorpse>

       <!--From Humans-->
      <thinkTreeMain>Humanlike</thinkTreeMain>
      <thinkTreeConstant>HumanlikeConstant</thinkTreeConstant>
      <intelligence>Humanlike</intelligence>

      <foodType>OmnivoreHuman</foodType>

      <lifeStageWorkSettings MayRequire="Ludeon.RimWorld.Biotech">
        <Firefighter>7</Firefighter>
        <Patient>0</Patient>
        <Doctor>10</Doctor>
        <PatientBedRest>0</PatientBedRest>
        <Childcare MayRequire="Ludeon.RimWorld.Biotech">0</Childcare>
        <BasicWorker>3</BasicWorker>
        <Warden>10</Warden>
        <Handling>7</Handling>
        <Cooking>7</Cooking>
        <Hunting>7</Hunting>
        <Construction>10</Construction>
        <Growing>7</Growing>
        <Mining>7</Mining>
        <PlantCutting>7</PlantCutting>
        <Smithing>13</Smithing>
        <Tailoring>7</Tailoring>
        <Art>10</Art>
        <Crafting>7</Crafting>
        <Hauling>3</Hauling>
        <Cleaning>3</Cleaning>
        <Research>13</Research>
        <DarkStudy MayRequire="Ludeon.RimWorld.Anomaly">13</DarkStudy>
      </lifeStageWorkSettings>

      <hediffGiverSets Inherit="false">
        <li>OrganicDragon</li>
      </hediffGiverSets>
      <lifeExpectancy>2000</lifeExpectancy>

      <nameGenerator>NamerAnimalDragonMale</nameGenerator>
      <nameGeneratorFemale>NamerAnimalDragonFemale</nameGeneratorFemale>
      <packAnimal>true</packAnimal>
      <herdAnimal>false</herdAnimal>
      <body>QuadrupedeAnimalWithClawsDragon</body>
      <baseBodySize>4.1</baseBodySize>
      <baseHungerRate>1.3</baseHungerRate>
      <baseHealthScale>14</baseHealthScale>
      <predator>true</predator>
      <leatherDef>Dragon_Leather</leatherDef>
      <meatLabel>Dragon meat</meatLabel>
      <trainability>Advanced</trainability>
      <manhunterOnDamageChance>5</manhunterOnDamageChance>
      <gestationPeriodDays>60</gestationPeriodDays>
      <manhunterOnTameFailChance>0.2</manhunterOnTameFailChance>
      <maxPreyBodySize>4</maxPreyBodySize>
      <nuzzleMtbHours>90</nuzzleMtbHours>
      <litterSizeCurve>
        <points>
          <li>(0.5, 0)</li>
          <li>(1, 1)</li>
          <li>(2, 0)</li>
        </points>
      </litterSizeCurve>
      <lifeStageAges>
        <li>
          <def>HumanlikeBaby</def>
          <minAge>0</minAge>
          <soundWounded>Baby_Dragon_Wounded</soundWounded>
          <soundDeath>Baby_Dragon_Death</soundDeath>
          <soundCall>Baby_Dragon_Call</soundCall>
          <soundAngry>Baby_Dragon_Angry</soundAngry>
        </li>
        <li>
          <def>HumanlikeChild</def>
          <minAge>5</minAge>
          <soundWounded>Dragon_Wounded</soundWounded>
          <soundDeath>Dragon_Death</soundDeath>
          <soundCall>Dragon_Call</soundCall>
          <soundAngry>Dragon_Angry</soundAngry>
        </li>
        <li MayRequire="Ludeon.RimWorld.Biotech">
          <def>HumanlikePreTeenager</def>
          <minAge>10</minAge>
          <soundWounded>Dragon_Wounded</soundWounded>
          <soundDeath>Dragon_Death</soundDeath>
          <soundCall>Dragon_Call</soundCall>
          <soundAngry>Dragon_Angry</soundAngry>
        </li>
        <li>
          <def>HumanlikeTeenager</def>
          <minAge>20</minAge>
          <soundWounded>Dragon_Wounded</soundWounded>
          <soundDeath>Dragon_Death</soundDeath>
          <soundCall>Dragon_Call</soundCall>
          <soundAngry>Dragon_Angry</soundAngry>
        </li>
        <li>
          <def>HumanlikeAdult</def>
          <minAge>30</minAge>
          <soundWounded>Dragon_Wounded</soundWounded>
          <soundDeath>Dragon_Death</soundDeath>
          <soundCall>Dragon_Call</soundCall>
          <soundAngry>Dragon_Angry</soundAngry>
        </li>
      </lifeStageAges>
      <soundMeleeHitPawn>Dragon_HitPawn</soundMeleeHitPawn>
      <soundMeleeHitBuilding>Dragon_HitPawn</soundMeleeHitBuilding>
      <soundMeleeMiss>Pawn_Melee_BigBash_Miss</soundMeleeMiss>
      <ageGenerationCurve>
        <points>
          <li>(20,0)</li>
          <li>(40,25)</li>
          <li>(50,30)</li>
          <li>(200,100)</li>
          <li>(700,100)</li>
          <li>(1000,60)</li>
          <li>(1200,40)</li>
          <li>(1500,20)</li>
          <li>(1800,12)</li>
          <li>(2000,0)</li>
        </points>
      </ageGenerationCurve>
      <useMeatFrom>Red_Dragon</useMeatFrom>
    </race>
    <butcherProducts>
      <DragonHorn>1</DragonHorn>
    </butcherProducts>
    <modExtensions>
      <li Class="MorrowRim.ExtendedRaceProperties" MayRequire="SirMashedPotato.MorrowRim">
        <ashResistant>Resistant</ashResistant>
      </li>
      <li Class="DD.SettingControlledExtension_AnimalBiome" />
      <li Class="DD.DrugTargetExtension" />
      <li Class="DD.MatingTargetExtension" />
      <li Class="DD.RitualTargetExtension" />
      <li Class="DD.WingedFlyerExtension">
        <flightSpeed>14</flightSpeed>
        <flyingGraphicData Class="DD.AnimationGraphicData">
          <texPath>Things/Pawn/Animal/Flight</texPath>
          <graphicClass>DD.Graphic_Animation</graphicClass>
          <drawSize>5.2</drawSize>
          <ticksPerFrame>25</ticksPerFrame>
        <shadowData>
            <volume>(2, 1.5, 0.5)</volume>
            <offset>(0,0,-0.5)</offset>
          </shadowData>
        </flyingGraphicData>
        <variants>
          <li>
            <variantPath>Things/Pawn/Animal/BLDragon/BLDragon1</variantPath>
            <variantData>
              <texPath>Things/Pawn/Animal/BLDragon/Flight/Flight1</texPath>
            </variantData>
          </li>
          <li>
            <variantPath>Things/Pawn/Animal/BLDragon/BLDragon2</variantPath>
            <variantData>
              <texPath>Things/Pawn/Animal/BLDragon/Flight/Flight2</texPath>
            </variantData>
          </li>
          <li>
            <variantPath>Things/Pawn/Animal/BLDragon/BLDragon3</variantPath>
            <variantData>
              <texPath>Things/Pawn/Animal/BLDragon/Flight/Flight3</texPath>
            </variantData>
          </li>
          <li>
            <variantPath>Things/Pawn/Animal/BLDragon/BLDragon4</variantPath>
            <variantData>
              <texPath>Things/Pawn/Animal/BLDragon/Flight/Flight4</texPath>
            </variantData>
          </li>
        </variants>
      </li>
      <li Class="DD.CarryCapacityExtension">
        <constant>360</constant>
        <offset>100</offset>
        <factor>2.4</factor>
        <cap>1~1000</cap>
      </li>
      <li Class="DD.BreedingPoolExtension">
        <pool>CommonDragons</pool>
      </li>
      <li Class="DD.GenusMarkerExtension">
        <genus>DraconicCommon</genus>
      </li>
      <li Class="BigAndSmall.RaceExtension"> <raceHediff>DD_Blue_Dragon_RaceHediff</raceHediff> </li>

    </modExtensions>
  </ThingDef>

  <PawnKindDef ParentName="BaseDragonKind">
    <defName>DD_Blue_Dragon</defName>
    <label>blue dragon</label>
    <race>DD_Blue_Dragon</race>
    <combatPower>1260</combatPower>
    <canArriveManhunter>false</canArriveManhunter>
    <ecoSystemWeight>0</ecoSystemWeight>
    <initialWillRange>0~1</initialWillRange>
    <initialResistanceRange>10~17</initialResistanceRange>
    <alternateGraphicChance>1</alternateGraphicChance>
    <alternateGraphics>
      <li>
        <texPath>Things/Pawn/Animal/BLDragon/BLDragon1</texPath>
        <weight>0.33</weight>
      </li>
      <li>
        <texPath>Things/Pawn/Animal/BLDragon/BLDragon2</texPath>
        <weight>0.11</weight>
      </li>
      <li>
        <texPath>Things/Pawn/Animal/BLDragon/BLDragon3</texPath>
        <weight>0.33</weight>
      </li>
      <li>
        <texPath>Things/Pawn/Animal/BLDragon/BLDragon4</texPath>
        <weight>0.22</weight>
      </li>

    <modExtensions>
      <li Class="VEF.Abilities.PawnKindAbilityExtension">
        <giveAbilities>
          <li>DD_DragonJump</li>
          <li>DD_DragonBreath_Fire</li>
          <li>DD_DragonSpit_Fire</li>
          <li>DD_DraconicFlight</li>
        </giveAbilities>
        <giveRandomAbilities>false</giveRandomAbilities>
      </li>
      <li Class="BigAndSmall.PawnKindExtension">
        <generateHumanlikeAnimalFromThis>true</generateHumanlikeAnimalFromThis>
      </li>
    </modExtensions>
  </PawnKindDef>
</Defs>